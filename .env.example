# WorldVision Summons — local secrets (copy to `.env`)
#
# Text sheet generation works with a standard Gemini API key.
# LIVE Nano Banana / Gemini *image* portraits require billing enabled on the
# Google AI Studio / Cloud project (free-tier image models currently report limit: 0).
# Without billing, /api/generate-image returns a procedural SVG plate + BILLING_REQUIRED.

GEMINI_API_KEY=
# Optional: force Vertex Imagen attempts (needs Vertex project credentials)
# GEMINI_USE_IMAGEN=1
# GOOGLE_CLOUD_PROJECT=
